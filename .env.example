# =============================================================================
# NT548 - LOCAL ENVIRONMENT TEMPLATE
# Sao chép file này thành `.env`, sau đó thay các giá trị CHANGE_ME.
# Không commit file `.env` hoặc thông tin đăng nhập thật lên Git.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE - MySQL / Amazon RDS for MySQL / Aurora MySQL
# Ví dụ RDS: nt548-db.xxxxxxxxx.ap-southeast-1.rds.amazonaws.com
# Khi chạy MySQL local bằng Docker, DB_HOST thường là tên service database.
# -----------------------------------------------------------------------------
MYSQL_IMAGE=mysql:8.4
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
DB_HOST=mysql
DB_PORT=3306
DB_NAME=nt548
DB_USER=nt548_app
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

# Dùng `false` cho MySQL local và `true` cho AWS RDS/Aurora.
DB_SSL=false
# Đường dẫn tới CA certificate khi DB_SSL=true, ví dụ /run/secrets/rds-ca.pem.
DB_SSL_CA=
DB_CHARSET=utf8mb4
DB_TIMEZONE=Z
DB_CONNECT_TIMEOUT_SECONDS=10
DB_POOL_MAX=10

# PostgreSQL local: User/Product/Order Backend có tài khoản và quyền riêng.
# Service db-init tạo role và đồng bộ mật khẩu từ các biến bên dưới.
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_ADMIN_PASSWORD
PRODUCT_DB_PASSWORD=CHANGE_ME_PRODUCT_DB_PASSWORD
USER_DB_PASSWORD=CHANGE_ME_USER_DB_PASSWORD
ORDER_DB_PASSWORD=CHANGE_ME_ORDER_DB_PASSWORD

# -----------------------------------------------------------------------------
# AUTHENTICATION
# JWT_SECRET phải là chuỗi ngẫu nhiên dài tối thiểu 32 ký tự ở production.
# -----------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS
TOKEN_TTL_SECONDS=3600

# Dùng để khởi tạo admin trong bảng users; API đăng nhập đọc hash từ DB.
# Sửa ADMIN_PASSWORD ở đây không đổi password_hash đã lưu trong PostgreSQL.
ADMIN_EMAIL=admin@nt548.local
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
NODE_ENV=production
APP_PORT=8080
RESTART_POLICY=unless-stopped
